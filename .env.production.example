# ─────────────────────────────────────────────────────────────
# Production environment variables (set these in Railway, per service).
# NEVER commit real values — this file only documents what's needed.
# ─────────────────────────────────────────────────────────────

# ── Backend API + Worker services ──
# Your Anthropic API key (the 5 agents use it)
ANTHROPIC_API_KEY=sk-ant-...

# Provided automatically by Railway's Postgres and Redis plugins.
# Reference them in the dashboard as ${{ Postgres.DATABASE_URL }} and ${{ Redis.REDIS_URL }}.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
REDIS_URL=redis://default:pass@host:6379

# Comma-separated browser origins allowed to call the API.
# Set this to your deployed frontend URL.
ALLOWED_ORIGINS=https://your-frontend.up.railway.app

# ── Frontend service ──
# Public URL of the deployed backend API (the browser calls this).
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
